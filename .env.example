# Reference only. The application deliberately does NOT auto-load dotenv files.
# Set variables explicitly in a dedicated PowerShell session; see LOCAL-REFINEMENT.md.
APP_ENV=development
FLASK_SKIP_DOTENV=1
SECRET_KEY=
DATABASE_URL=postgresql://example_user:example_password@localhost:5432/example_db
# Required only in production: independent nonsecret pins for the NEW database.
EXPECTED_DATABASE_HOST=
EXPECTED_DATABASE_NAME=
ALLOW_LOCAL_DATABASE=0
APP_BASE_URL=http://127.0.0.1:5000
# Email is disabled in development and test. Never use real mail in local tests.
ENABLE_EMAIL=0
BREVO_API_KEY=
GMAIL_ADDRESS=
